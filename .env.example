# Copy this file to .env and fill in the values before running docker compose.
# Never commit the resulting .env — it is gitignored by default.

# Required — PostgreSQL superuser password for the `septum` database.
POSTGRES_PASSWORD=

# Required — Redis AUTH password used by --requirepass and every connection URL.
REDIS_PASSWORD=

# Optional — air-gapped host only (docker-compose.airgap.yml). Queue URL of the gateway-zone Redis,
# e.g. redis://:<gateway REDIS_PASSWORD>@<gateway-private-ip>:6379/0.
# Routing through the gateway is NOT wired yet: the api currently ignores SEPTUM_QUEUE_URL.
# Unset = local Redis (single-host dev). Never put this value on the gateway host.
# SEPTUM_QUEUE_URL=

# Required on the gateway host (docker-compose.gateway.yml) — the Redis queue's published
# interface: the gateway host's private/VPN IP. Never 0.0.0.0. Compose refuses to start without it.
# Docker-published ports bypass ufw/firewalld INPUT rules; also restrict with DOCKER-USER if needed.
# SEPTUM_GATEWAY_REDIS_BIND=<gateway-private-ip>

# Optional — gateway health and audit API binds. Default 127.0.0.1 (loopback only).
# SEPTUM_GATEWAY_HEALTH_BIND=127.0.0.1
# SEPTUM_AUDIT_BIND=127.0.0.1

# Optional — host interface for the Ollama published port in docker-compose.yml.
# Default 127.0.0.1. Containers use http://ollama:11434 and are unaffected. Ollama has no auth:
# do not bind it to a routable address.
# SEPTUM_OLLAMA_BIND=127.0.0.1

# Optional — host interface for the remote MCP server port (8765, mcp profile).
# Default 127.0.0.1. Set deliberately to a private/VPN IP for team use. Requires SEPTUM_MCP_HTTP_TOKEN.
# Docker-published ports bypass ufw/firewalld INPUT rules; restrict with DOCKER-USER if needed.
# SEPTUM_MCP_BIND=127.0.0.1
