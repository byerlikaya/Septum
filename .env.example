# Copy this file to .env and fill in the values before running docker compose.
# Never commit the resulting .env — it is gitignored by default.

# Required — PostgreSQL superuser password for the `septum` database.
POSTGRES_PASSWORD=

# Required (docker-compose.yml, docker-compose.airgap.yml) — the local Redis' default-user password
# (--requirepass), used by the api's REDIS_URL. Not used on the gateway host.
REDIS_PASSWORD=

# Queue Redis ACL users, one password each. Generate each with `openssl rand -hex 32`
# (hex only: no spaces or quotes, which Redis' --user arguments cannot carry).
#   docker-compose.yml, docker-compose.gateway.yml: all four required.
#   docker-compose.airgap.yml: only SEPTUM_QUEUE_API_PASSWORD, the same value as on the gateway host.
# Never copy the gateway, audit or health passwords to the air-gapped host.
SEPTUM_QUEUE_API_PASSWORD=
SEPTUM_QUEUE_GATEWAY_PASSWORD=
SEPTUM_QUEUE_AUDIT_PASSWORD=
SEPTUM_QUEUE_HEALTH_PASSWORD=

# Required on the air-gapped host (docker-compose.airgap.yml) — the gateway-zone Redis as
# <gateway-private-ip>:6379. The zone-edge relay forwards the api's queue connection there;
# nothing else in the zone can reach it.
# SEPTUM_GATEWAY_QUEUE_ADDR=<gateway-private-ip>:6379

# Optional — air-gapped host only. Overrides the default queue URL
# redis://septum-api:<SEPTUM_QUEUE_API_PASSWORD>@zone-edge:6379/0. Keep the zone-edge host:
# the api has no other route out of the zone. Never put this value on the gateway host.
# SEPTUM_QUEUE_URL=

# Optional — air-gapped host only. Fixed addresses on the internal zone network; override all
# five together if 172.28.70.0/24 collides with a host network (see docker-compose.airgap.yml).
# The zone-edge relay forwards the queue only from SEPTUM_API_IP.
# SEPTUM_SUBNET=172.28.70.0/24
# SEPTUM_DYNAMIC_IP_RANGE=172.28.70.128/25
# SEPTUM_WEB_IP=172.28.70.10
# SEPTUM_ZONE_EDGE_IP=172.28.70.11
# SEPTUM_API_IP=172.28.70.12

# Optional (docker-compose.yml, docker-compose.gateway.yml) — memory cap of the queue Redis
# (Redis size syntax, e.g. 512mb, 2gb). Policy is noeviction: when full, new queue writes fail
# instead of silently dropping messages.
# SEPTUM_QUEUE_REDIS_MAXMEMORY=256mb

# Required on the gateway host (docker-compose.gateway.yml) — the Redis queue's published
# interface: the gateway host's private/VPN IP. Never 0.0.0.0. Compose refuses to start without it.
# Docker-published ports bypass ufw/firewalld INPUT rules; also restrict with DOCKER-USER if needed.
# SEPTUM_GATEWAY_REDIS_BIND=<gateway-private-ip>

# Optional — gateway health and audit API binds. Default 127.0.0.1 (loopback only).
# SEPTUM_GATEWAY_HEALTH_BIND=127.0.0.1
# SEPTUM_AUDIT_BIND=127.0.0.1

# Optional — host interface for the Ollama published port in docker-compose.yml (the air-gapped
# variant runs Ollama inside the zone and publishes nothing).
# Default 127.0.0.1. Containers use http://ollama:11434 and are unaffected. Ollama has no auth:
# do not bind it to a routable address.
# SEPTUM_OLLAMA_BIND=127.0.0.1

# Optional — host interface for the remote MCP server port (8765, mcp profile).
# Default 127.0.0.1. Set deliberately to a private/VPN IP for team use. Requires SEPTUM_MCP_HTTP_TOKEN.
# Docker-published ports bypass ufw/firewalld INPUT rules; restrict with DOCKER-USER if needed.
# SEPTUM_MCP_BIND=127.0.0.1
